{
  "name": "dataworld-stock-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Logiciel de gestion de stock DATAWORLD Sarl — version bureau Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:vite": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "express": "^4.19.2",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.dataworld.stock",
    "productName": "DATAWORLD Stock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
